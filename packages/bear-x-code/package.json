{
  "name": "@forgedevstack/bear-x-code",
  "version": "0.1.0",
  "description": "Bear X code tools. CodeEditor, Terminal, DiffViewer, JsonViewer, and DiffSquares. Requires @forgedevstack/bear styles.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/vite/bin/vite.js build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@forgedevstack/bear": ">=1.3.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "sideEffects": false
}
