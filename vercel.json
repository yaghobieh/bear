{
  "installCommand": "npm install && npm run portal:install",
  "buildCommand": "npm run portal:build",
  "outputDirectory": "portal/dist",
  "functions": {
    "api/bear-ask.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/storybook", "destination": "/storybook/index.html" },
    { "source": "/storybook/", "destination": "/storybook/index.html" },
    { "source": "/blog/bear-1-3-6", "destination": "/blog/bear-1-3-6.html" },
    { "source": "/((?!storybook(?:/|$)|api(?:/|$)|blog/bear-1-3-6(?:\\.html)?$).*)", "destination": "/index.html" }
  ]
}
