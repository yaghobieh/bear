{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@utils": ["../src/utils"],
      "@hooks": ["../src/hooks"],
      "@hooks/*": ["../src/hooks/*"],
      "@context": ["../src/context"],
      "@context/*": ["../src/context/*"],
      "@types": ["../src/types"],
      "@const": ["../src/constants"],
      "@constants": ["../src/constants"],
      "@forgedevstack/bear-x-charts": ["../packages/bear-x-charts/src/index.ts"],
      "@forgedevstack/bear-x-ai": ["../packages/bear-x-ai/src/index.ts"],
      "@forgedevstack/bear-x-code": ["../packages/bear-x-code/src/index.ts"],
      "@forgedevstack/bear-map": ["../packages/bear-map/src/index.ts"],
      "@forgedevstack/kanban": ["../packages/kanban/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/stories"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

