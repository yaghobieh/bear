{
  "name": "bear-portal",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "dependencies": {
    "@forgedevstack/bear": "file:..",
    "@forgedevstack/bear-icons": "^1.0.1",
    "@forgedevstack/grid-table": "1.0.2",
    "lz-string": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "scripts": {
    "predev": "cd .. && npm run build",
    "prebuild": "cd .. && npm run build",
    "dev": "concurrently -k -n portal,storybook -c cyan,magenta \"vite\" \"storybook dev -p 6006 --no-open\"",
    "dev:portal": "vite",
    "dev:e2e": "vite --port 5174",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist/storybook",
    "build": "npx tsc && npx vite build && npm run build-storybook",
    "preview": "vite preview",
    "test:e2e": "playwright test --config=e2e/playwright.config.cjs",
    "test:e2e:smoke": "BEAR_E2E_SMOKE=1 playwright test --config=e2e/playwright.config.cjs",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.cjs --ui",
    "test:storybook": "test-storybook --url http://localhost:6006 --maxWorkers=2",
    "test:storybook:smoke": "test-storybook --url http://localhost:6006 --includeTags smoke-test --maxWorkers=1",
    "type-check": "npx tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/test-runner": "^0.23.0",
    "@storybook/theming": "^8.6.14",
    "@types/lz-string": "^1.3.34",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.32",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
