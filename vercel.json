{
  "installCommand": "npm install && npm run portal:install",
  "buildCommand": "npm run portal:build",
  "outputDirectory": "portal/dist",
  "rewrites": [
    { "source": "/storybook", "destination": "/storybook/index.html" },
    { "source": "/storybook/", "destination": "/storybook/index.html" },
    { "source": "/((?!storybook(?:/|$)).*)", "destination": "/index.html" }
  ]
}
